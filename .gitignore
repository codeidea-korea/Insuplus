#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
html/pilot
_data/
git

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log
log_*.txt

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

_session/*
_log/*
up_file/*
*.ttf
*.ufm
_util/PHPExcel-1.8/Documentation/assets/ClassDiagrams/obj/Debug/.NETFramework,Version=v4.0.AssemblyAttributes.cs
_util/PHPExcel-1.8/Documentation/assets/ClassDiagrams/obj/Debug/ClassDiagrams.csproj.AssemblyReference.cache

*_org*
*.bak
*.xlsx

vendor/
*data*bak/
_data.tar.gz
